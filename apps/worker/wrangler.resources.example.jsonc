{
  // Copy the relevant bindings after creating the resources in your Cloudflare account.
  "d1_databases": [{ "binding": "DB", "database_name": "openaction", "database_id": "REPLACE_WITH_D1_ID" }],
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "openaction-snapshots" }],
  "queues": {
    "producers": [{ "binding": "INGEST_QUEUE", "queue": "openaction-ingest" }],
    "consumers": [{ "queue": "openaction-ingest", "max_batch_size": 10, "max_batch_timeout": 30, "max_retries": 5, "dead_letter_queue": "openaction-ingest-dlq" }]
  },
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "openaction-evidence" }],
  "ai": { "binding": "AI" },
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    "AI_GATEWAY_ID": "REPLACE_WITH_YOUR_GATEWAY_ID",
    "ADMIN_TOKEN": "USE_A_WRANGLER_SECRET_IN_PRODUCTION"
  }
}
